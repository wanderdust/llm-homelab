# Shared model/server config: the single source of truth for BOTH Docker and k3s.
# llama-server reads every LLAMA_ARG_* variable as if it were a CLI flag.
# Keep comments on their own lines: kubectl --from-env-file does not strip inline comments.

# Model to download from Hugging Face (check the exact repo name)
LLAMA_ARG_HF_REPO=unsloth/Qwen3.5-4B-GGUF:Q4_K_M
# The model "id" clients (Pi) ask for
LLAMA_ARG_ALIAS=qwen3.5-4b
# Total context, split across slots (32768 / 2 = 16384 per request)
LLAMA_ARG_CTX_SIZE=32768
# Concurrent request slots
LLAMA_ARG_N_PARALLEL=2
# Offload all layers to the GPU
LLAMA_ARG_N_GPU_LAYERS=99
# Use the model's chat template (needed for tool calls)
LLAMA_ARG_JINJA=true
# Expose Prometheus metrics at /metrics
LLAMA_ARG_ENDPOINT_METRICS=true
